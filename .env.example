# Choose "openai", "azure", or "ollama" -- everything else in the code stays identical either way
LLM_PROVIDER=ollama

# --- Plain OpenAI (used if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=<your-key>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Azure OpenAI (used if LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# --- Local Ollama (used if LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# --- Local paths ---
SOURCE_DOCS_PATH=data/sample_docs
PROCESSED_DATA_PATH=data/processed
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# --- Pipeline params ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
TOP_K_RETRIEVAL=5
